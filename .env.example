# ───────── Сервер (секреты — НИКОГДА не попадают в браузер) ─────────
# SoundCloud: зарегистрируйте приложение на https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Порт сервера в продакшене (в разработке API всегда на 8787)
# PORT=8787

# ───────── Клиент (публичные значения, префикс VITE_) ─────────
# Supabase: Project Settings → API. anon key публичный и защищён политиками RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────── Аккаунты и подписки (только сервер, НИКОГДА не в браузер) ─────────
# Supabase → Project Settings → API → service_role. Даёт полный доступ к базе:
# храните только на сервере и не добавляйте префикс VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ЮKassa → Интеграция → Ключи API. Для тестового магазина ключ начинается с test_
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — если в магазине включены чеки (54-ФЗ). Код НДС: 1 = без НДС
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
# Публичный адрес сайта для возврата после оплаты, например https://aura.example.ru
PUBLIC_URL=
# Десктоп-приложение обращается к оплате на вашем сервере: разрешённые источники
BILLING_CORS_ORIGINS=http://127.0.0.1:47831
# (клиент) адрес сервера оплаты для десктоп-сборки, например https://aura.example.ru
VITE_BILLING_API_URL=
